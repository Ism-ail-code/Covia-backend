// Covia backend — environment variables
// Copy to .env and fill in real values. NEVER commit .env.

# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (CORS).
# Leave empty to allow all origins during development only.
CORS_ORIGINS=

# ── Database ───────────────────────────────────────────────────
# PostgreSQL connection string.
# Local dev (embedded Postgres, see scripts/dev-db.mjs):
DATABASE_URL=postgresql://covia:covia_dev_password@localhost:5433/covia
# Production example:
# DATABASE_URL=postgresql://user:password@host:5432/covia?schema=public

# ── Authentication (installed only — implemented in a later phase) ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# ── Rate limiting ──────────────────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# ── Logging ────────────────────────────────────────────────────
# One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Integrations (placeholders — wired up in later phases) ─────
# File storage (e.g. S3-compatible bucket)
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=

# Push notifications
PUSH_NOTIFICATIONS_URL=
PUSH_NOTIFICATIONS_APP_ID=

# Maps / geocoding
MAPS_API_KEY=

# Email service
EMAIL_SERVICE_URL=
EMAIL_SERVICE_API_KEY=
